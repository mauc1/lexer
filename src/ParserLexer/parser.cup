/* Simple +/-/* expression language; parser evaluates constant expressions on the fly*/
package ParserLexer;
import java_cup.runtime.*;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.LinkedHashMap;
import java.io.IOException;
import java.io.BufferedWriter;
import java.io.FileWriter;
import ParserLexer.arbol.*;
import java.util.List;

action code {:
    LinkedHashMap<String, ArrayList<String>> listaTablasSimbolos = new LinkedHashMap<String, ArrayList<String>>();
    ArrayList<FunctionObject> funcs = new ArrayList<FunctionObject>();
    HashMap<String, TablaSimbolo> pilaSimbolos = new HashMap<String, TablaSimbolo>();
    String currHash = "";

    public void imprimirTablaSimbolos(){
        for (String key : listaTablasSimbolos.keySet()) {
            System.out.println("Tabla de simbolos: " + key);
            System.out.println("Valores: ");
            for (String item : listaTablasSimbolos.get(key)) {
                System.out.println(item);
            }
            System.out.println("");
        }
    }

    //escribir en archivo la tabla de simbolos
    public void escribirTablaSimbolos(String nombreArchivo){
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(nombreArchivo))) { //revisar si el path esta bien
            for (String key : listaTablasSimbolos.keySet()) {
                writer.write("\nTabla de simbolo: " + key + "\n");
                writer.write("Valores : \n");
                for (String item : listaTablasSimbolos.get(key)) {
                    writer.write(item);
                }
                writer.write("\n");
            }
        } catch (IOException e) {
            System.out.println("Error escribiendo tabla de simbolos");
            e.printStackTrace();
        }
    }

    public TipoDato validarTipos(String ope, Dato op1, Dato op2, ArrayList<TipoDato> tipos){
        if (op1.getTipo() != op2.getTipo()) {
            System.out.println("Error: tipos no compatibles en la operacion " + ope);
            return TipoDato.NULO; //o nulo
        } 
        if (!tipos.contains(op1.getTipo())) {
            System.out.println("Error: tipo no valido en la operacion " + ope);
            return TipoDato.NULO;
        }
        return op1.getTipo();
    }

     public String existeValor(String pSim){
      for (Simbolo valor : pilaSimbolos.get(currHash).getTablaSimbolos()) {
        if (valor.getId() == pSim) {
          //return value.getDireccion();
          return " ";
        }
      }
      return null;
    }

    public FunctionObject buscarFunc(String pId){
      for(FunctionObject func : funcs){
        if(func.getIdFuncion().equals(pId)){
            return func;
        }
      }
      return null;
    }

    public TipoDato getTipo(String pId, boolean reportar){
        for (Simbolo dato : pilaSimbolos.get(currHash).getTablaSimbolos()) {
              System.out.println("A: "+dato.getId());
          if (dato.getId().equals(pId)) {
            return Dato.tipoFromString(dato.getTipo());
          }
        }
        if (reportar){
          semantic_error("misc", ("Error semantico en la linea " + (lex.getLine() + 1) + " columna " + (lex.getColumn() + 1) + ": " + "Ya que no se ha definido el id: " + pId));
        }
        return TipoDato.NULO;
    }
:}

parser code {:
       // Connect this parser to a scanner!
    Lexer lex;
    boolean syntaxError;
    ArrayList<String> errores = new ArrayList<String>();
    String errorActual = "";
    @SuppressWarnings("deprecation")
    public parser(Lexer lex){
        this.lex = lex;
        this.symbolFactory = new DefaultSymbolFactory();
        this.syntaxError = false; // Inicializar el booleano de errores
    }


    /*Funcion syntax_error sobreescrita para el manejo de errores en idioma espaniol 
    Recibe de parametro el symbol del token actual en el que se ha encontrado un error
    No retorna nada 
    */
    public void syntax_error(Symbol errorSymbol) {//Se imprime la linea y columna del error
        errorActual = "Error sintactico en la linea: " + errorSymbol.left + ", y columna " + errorSymbol.right;
        //System.err.println("Error sintactico en la linea: " + errorSymbol.left + ", y columna " + errorSymbol.right );
        this.errores.add(errorActual);
        this.syntaxError = true; //El booleano se pone en true para indicar que se encontro un error 
    }

    public void semantic_error(String pTipo, String pExpresion){
        switch(pTipo){
          case "local":
              //System.out.println("Error semantico local en la linea " + (lex.getLine()+1) + " columna " + lex.getColumn() + ": " + "Debido al dato ya existente: " + pExpresion);
              errorActual = "Error semantico en la linea " + (lex.getLine()+1) + " columna " + lex.getColumn() + ": " + "Debido a la variable ya existente: " + pExpresion;
              this.errores.add(errorActual);
              this.syntaxError = true;
              break;
          case "param":
              //System.out.println("Error semantico local en la linea " + (lex.getLine()+1) + " columna " + lex.getColumn() + ": " + "Debido al dato ya existente: " + pExpresion);
              errorActual = "Error semantico en la linea " + (lex.getLine()+1) + " columna " + lex.getColumn() + ": " + "Debido al parametro repetido: " + pExpresion;
              this.errores.add(errorActual);
              this.syntaxError = true;
              break;
          case "fun":
              //System.out.println("Error semantico local en la linea " + (lex.getLine()+1) + " columna " + lex.getColumn() + ": " + "Debido al dato ya existente: " + pExpresion);
              errorActual = "Error semantico en la linea " + (lex.getLine()+1) + " columna " + lex.getColumn() + ": " + "Debido a la funcion ya existente: " + pExpresion;
              this.errores.add(errorActual);
              this.syntaxError = true;
              break;
          case "main":
              errorActual = "Error semantico debido a que no existe funcion main";
              this.errores.add(errorActual);
              this.syntaxError = true;
              break;
          case "ftipo":
              errorActual = "Error semantico en la linea " + (lex.getLine() + 1) + " columna " + (lex.getColumn() + 1) + ": " + "El tipo " + pExpresion + " no es valido para una funcion";
              this.errores.add(errorActual);
              this.syntaxError = true;
              break;
           case "misc":
              this.errores.add(pExpresion);
              this.syntaxError = true;
              break;

//variable no existente: var
//mal retorno: return
//mala asignacion: assign
//
          
        }
    }
    // Metodo que verifica si hubo un error sintactico, el cual no recibe ni retorna valores 
    public boolean huboError() {
        return syntaxError;
    }

    //Metodo que imprime si hubo error sintactico y si la gramatica puede ser generada 
    public void estadoGramatica() {
        if (huboError()) {
            System.out.println("El archivo fuente no puede ser generado por la gramatica, debido a errores encontrados en estas partes del archivo:\n");
            for(String currentError : errores){
                System.out.println("\t " + currentError);            
            }

        } else {
            System.out.println("El archivo fuente si puede ser generado por la gramatica");
        }
    }
:}

/* define how to connect to the scanner! */
init with {: :};
scan with {: return lex.next_token(); :};

//Terminales de tipos
terminal INTEGER, FLOAT, BOOL, CHAR, STRING, VOID, NULO;

//Terminales relacionales
terminal MENOR, MENORIGUAL, MAYOR, MAYORIGUAL, IGUALDAD, DIFERENTE;

//Terminales de parentesis y llaves
terminal PARENIZQ, PARENDER, BRACEIZQ, BRACEDER, CORCHETEIZQ, CORCHETEDER;

//Terminales aritmeticos unarios 
terminal INCREMENTO, DECREMENTO;

//Terminales aritmeticos binarios
terminal SUMA, RESTA, DIVISION, MULTIPLICACION, MODULO, POTENCIA;

//Terminales operadores logicos
terminal CONJUNCION, DISYUNCION, NEGACION;

//Terminales estructuras de control de flujo
terminal IF, ELSE, FOR, WHILE, SWITCH, CASE, BREAK, RETURN, DOSPUNTOS;

//Terminales de identificadores y main
terminal IDENTIFICADOR, NUMERO, ERROR, ASIGNACION, MAIN;

//Terminales de finalizacion
terminal ENDEXPR, COMMA, COMILLA, COMILLADOBLE;

//terminales IO
terminal PRINT, READ;

//terminales booleanos
terminal TRUE, FALSE;

//terminales comentarios
terminal COMENTARIO, MULTICOMENTARIO;

//terminal de default
terminal DEFAULT;

//no terminales 
//funciones
non terminal inicio, funciones_produ, parametros, funcionRecur, funcion_produ, parametrosOpcionales;
non terminal tipos;

//flujos
non terminal if_produ, for_produ, while_produ, switch_produ, historia_produ, casodefault, estructurasControl;  
non terminal return_produ, break_produ, print_produ, read_produ, llamadaFuncion;


non terminal exprArit, exprLog, exprRel, factor, exprPrin ;
non terminal operadorLog, operadorRel, operadorArit, operandoUnario;
non terminal accesoArreglo, creacionasignacion, creacionArreglo, modificacionArreglo, valoresArreglo;

// Declaración de no terminales
non terminal ProgramNode program;
non terminal FunctionNode funcion; //esto es funcion
non terminal List<FunctionNode> funciones; //esto es funcionessss
non terminal BlockNode bloque_produ;
non terminal List<StatementNode> sentencias;
non terminal StatementNode sentencia;
non terminal CreacionNode creacion;
non terminal AsignacionNode asignacion;

//poner precedencias

start with inicio;


inicio ::= 
    funciones:f
    {: 
        RESULT = new ProgramNode(f);
        
        imprimirTablaSimbolos();
        escribirTablaSimbolos("tablaSimbolos.txt");
        System.out.println("---Fin---");
    :};

funciones ::= funcion:f {: List<FunctionNode> list = new ArrayList<>(); list.add(f); RESULT = list; :}
            | funciones:f1 funcion:f2 {: f1.add(f2); RESULT = f1; :};


funcion ::= 
            //funcion sin parametros 
            tipos:t IDENTIFICADOR:id PARENIZQ PARENDER bloque_produ:b 
            {: RESULT = new FunctionNode(id.toString(), b); 
                ArrayList<String> listaDatos = new ArrayList<String>();
                currHash = "funcion " + id.toString();
                String nombre_func = "\nnombre: " + id.toString();
                String tipo_dato = "tipo: " + t.toString();
                String ambito = "ambito: Funcion\n";
                listaDatos.add(nombre_func);
                listaDatos.add(tipo_dato);
                listaDatos.add(ambito);
                listaTablasSimbolos.put(currHash, listaDatos);
            :}

            //funcion con parametros
            | tipos:t IDENTIFICADOR:id PARENIZQ parametros PARENDER bloque_produ:b {: RESULT = new FunctionNode(id.toString(), b); :}

            //error en la declaracion de la funcion
            | error {:System.out.println("Error: encabezado no coincide con la gramatica.");
                Symbol token;
                do {
                    token = lex.next_token(); //este metodo ya lo trae el lexer
                    if (token.sym == sym.BRACEDER || token.sym == sym.EOF) { //busca el } final
                        System.out.println("Encontrado el } final");
                        break; 
                    }
                } while (token != null);
            :};

tipos ::= 
    INTEGER {:RESULT = "int";:}
    | FLOAT {:RESULT = "float";:}
    | BOOL {:RESULT = "bool";:}
    | CHAR {:RESULT = "char";:}
    | STRING {:RESULT = "string";:}
    | VOID {:RESULT = "void";:};

//cuerpo de las funciones

bloque_produ ::= 
    BRACEIZQ sentencias:s BRACEDER {: RESULT = new BlockNode(s); :};

sentencias ::= sentencia:s {: List<StatementNode> list = new ArrayList<>(); if (s == null) {
        System.out.println("ADVERTENCIA: Se intentó agregar una sentencia NULL a `sentencias`");
    } else {
        System.out.println(" Agregando sentencia de tipo: " + s.getClass().getSimpleName());
        list.add(s);
    }
    RESULT = list;  :}
            | sentencias:s1 sentencia:s2 {: 
             s1.add(s2); 
             System.out.println("Se agregó un statement a la lista. Total ahora: " + s1.size());
             RESULT = s1; :}
            | error 
                {:
                    System.out.println("Error: error en sentencia. Recuperando...");

                    Symbol token;
                    do {
                        token = lex.next_token(); //este metodo ya lo trae el lexer
                        if (token.sym == sym.ENDEXPR || token.sym == sym.EOF) {
                            break; 
                        }
                    } while (token != null); 

                :};

sentencia ::= creacion:c {: 
    if (c == null) {
        System.out.println("⚠️ ADVERTENCIA: `creacion` devolvió NULL en `sentencia`");
    } else {
        System.out.println(" creacion detectada correctamente.");
        RESULT = c;
    }
    
:} | asignacion:a {: 
    if (a == null) {
        System.out.println("⚠️ `asignacion` devolvió NULL en `sentencia`");
    } else {
        System.out.println("✅ `asignacion` detectada en `sentencia`.");
        
    }
:}  | creacionasignacion | estructurasControl | return_produ | break_produ | print_produ | read_produ | llamadaFuncion | modificacionArreglo | creacionArreglo;
creacionasignacion ::= tipos IDENTIFICADOR ASIGNACION exprPrin ENDEXPR ;
asignacion ::= IDENTIFICADOR:id ASIGNACION exprPrin:e ENDEXPR; //{: RESULT = new AsignacionNode(id.toString(), e); :};
creacion ::= tipos:t IDENTIFICADOR:id ENDEXPR {: 
//System.out.println("Creando variable de tipo: " + t.toString() + " con nombre: " + id);
RESULT = new CreacionNode(t.toString(), id.toString()); :};
 
exprPrin ::= exprLog ;
exprLog ::= exprLog operadorLog exprRel | exprRel | NEGACION exprRel ;
operadorLog ::= DISYUNCION | CONJUNCION ;
 
exprRel ::= exprArit operadorRel exprArit | exprArit ;
operadorRel ::= MAYOR | MENOR | MENORIGUAL | MAYORIGUAL | IGUALDAD | DIFERENTE; //XXX TERMINAR
 
exprArit ::= exprArit operadorArit factor
	| factor ;
 
operandoUnario ::= IDENTIFICADOR INCREMENTO
		| IDENTIFICADOR DECREMENTO ;
 
accesoArreglo ::= IDENTIFICADOR CORCHETEIZQ exprPrin CORCHETEDER ;
 
factor ::= INTEGER
    | CHAR
    | STRING
    | TRUE
    | FALSE
    | FLOAT
    | llamadaFuncion
	| operandoUnario
	| accesoArreglo
	| IDENTIFICADOR 
    | tipos IDENTIFICADOR
	| PARENIZQ exprPrin PARENDER  ;
 
operadorArit ::=  SUMA | RESTA | DIVISION | MULTIPLICACION | MODULO | POTENCIA ; 

//produccion de return
return_produ ::= RETURN exprPrin ENDEXPR ;

//produccion de break
break_produ ::= BREAK ENDEXPR ;

//produccion de print
print_produ ::= PRINT PARENIZQ exprPrin PARENDER ENDEXPR ;

//produccion de read
read_produ ::= READ PARENIZQ IDENTIFICADOR PARENDER ENDEXPR ;

//estructuras de control de flujo
estructurasControl ::= if_produ | for_produ | while_produ | switch_produ ;
//if y else
if_produ ::= 
    IF PARENIZQ exprPrin PARENDER bloque_produ
    | IF PARENIZQ exprPrin PARENDER bloque_produ ELSE bloque_produ
    ;

//for
for_produ ::= 
    FOR PARENIZQ asignacion exprPrin ENDEXPR exprPrin PARENDER bloque_produ 
    | FOR PARENIZQ creacionasignacion ENDEXPR exprPrin ENDEXPR exprPrin PARENDER bloque_produ 
    ;

//while
while_produ ::= 
    WHILE PARENIZQ exprPrin PARENDER bloque_produ
    ;

//switch

switch_produ ::= SWITCH PARENIZQ exprPrin PARENDER BRACEIZQ historia_produ casodefault BRACEDER ;

historia_produ ::= CASE factor DOSPUNTOS bloque_produ | historia_produ CASE tipos DOSPUNTOS bloque_produ ;
casodefault ::= DEFAULT DOSPUNTOS bloque_produ | /* vacío */ ;

//llamada de funciones
llamadaFuncion ::= IDENTIFICADOR PARENIZQ parametrosOpcionales PARENDER ENDEXPR ;
parametrosOpcionales ::= parametros | /* vacío */ ;
parametros ::= exprPrin | parametros COMMA exprPrin ;

creacionArreglo ::= tipos IDENTIFICADOR CORCHETEIZQ INTEGER CORCHETEDER ENDEXPR 
                  | tipos IDENTIFICADOR CORCHETEIZQ INTEGER CORCHETEDER ASIGNACION CORCHETEIZQ valoresArreglo CORCHETEDER ENDEXPR ;
valoresArreglo ::= exprPrin | valoresArreglo COMMA exprPrin ;

modificacionArreglo ::= IDENTIFICADOR CORCHETEIZQ exprPrin CORCHETEDER ASIGNACION exprPrin ENDEXPR ;

