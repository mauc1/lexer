/* Simple +/-/* expression language; parser evaluates constant expressions on the fly*/
package ParserLexer;
import java_cup.runtime.*;


action code {:
    HashMap<String, ArrayList<String>> listaTablasSimbolos = new HashMap<String, ArrayList<String>>();
    String currentHash;

    public void imprimirTablaSimbolos(){
        for (String key : listaTablasSimbolos.keySet()) {
            System.out.println("Tabla de simbolos: " + key);
            System.out.println("Valores: ");
            for (String item : listaTablasSimbolos.get(key)) {
                System.out.println(item);
            }
            System.out.println("");
        }
    }

    //escribir en archivo la tabla de simbolos
    public void escribirTablaSimbolos(String nombreArchivo){
        try {
            FileWriter myWriter = new FileWriter(nombreArchivo);
            for (String key : listaTablasSimbolos.keySet()) {
                myWriter.write("Tabla de simbolos: " + key + "\n");
                myWriter.write("Valores: \n");
                for (String item : listaTablasSimbolos.get(key)) {
                    myWriter.write(item + "\n");
                }
                myWriter.write("\n");
            }
            myWriter.close();
            System.out.println("Tabla de simbolos guardada en " + nombreArchivo);
        } catch (IOException e) {
            System.out.println("An error occurred.");
            e.printStackTrace();
        }
    }
:}

parser code {:
    BasicLexerCupV lex;

    @SupressWarnings("deprecation")
    public parser(LexerCup lex){
        this.lex = lex;
        this.symbolFactory = new DefaultSymbolFactory();
    }
:}

/* define how to connect to the scanner! */
init with {: :};
scan with {: return lex.next_token(); :};

//Terminales de tipos
terminal INTEGER, FLOAT, BOOL, CHAR, STRING;

//Terminales relacionales
terminal MENOR, MENORIGUAL, MAYOR, MAYORIGUAL, IGUALDAD, DIFERENTE;

//Terminales de parentesis y llaves
terminal PARENIZQ, PARENDER, BRACEIZQ, BRACEDER, CORCHETEIZQ, CORCHETEDER;

//Terminales aritmeticos unarios 
terminal INCREMENTO, DECREMENTO;

//Terminales aritmeticos binarios
terminal SUMA, RESTA, DIVISION, MULTIPLICACION, MODULO, POTENCIA;

//Terminales operadores logicos
terminal CONJUNCION, DISYUNCION, NEGACION;

//Terminales estructuras de control de flujo
terminal IF, ELSE, FOR, WHILE, SWITCH, CASE, BREAK, RETURN, DOSPUNTOS;

//Terminales de identificadores y main
terminal IDENTIFICADOR, NUMERO, ERROR, ASIGNACION, MAIN;

//Terminales de finalizacion
terminal ENDEXPR, COMMA, COMILLA, COMILLADOBLE;

//terminales IO
terminal PRINT, READ;

//terminales booleanos
terminal TRUE, FALSE;

//terminales comentarios
terminal COMENTARIO, MULTICOMENTARIO;

//terminal de default
terminal DEFAULT;

//no terminales 
non terminal funcion, inicio, main

funciones ::= funcion
            | funciones funcion
            ;

inicio ::= funciones main
        ;

ini ::= {::} inicio {: 
imprimirTablaSimbolos();
escribirTablaSimbolos("tablaSimbolos.txt");
:}

//programa inicial
programa ::= _verano_ funciones

//definicion de funciones y sus producciones
funciones ::= funcion | funciones funcion
funcion ::= encabezadoFunc bloque
encabezadoFunc ::= tipos identificador abreregalo parametros cierraregalo
parametros ::= parametro | parametro "," parametros
parametro ::= tipos identificador
bloque ::= abrecuento sentencias cierracuento

//definicion de sentencias y sus producciones
sentencias ::= sentencia finregalo | sentencias sentencia finregalo
sentencia ::= creacionVariable 
                | creacionAsignacion 
                | expresion 
                | imprimir 
                | leer 
                | retornar 
                | controlFlujo

//declaraciones y asignaciones
creacionVariable  ::= tipos identificador entrega expresion
creacionAsignacion ::= identificador entrega expresion

//definicion de expresiones y sus producciones
expresion          ::= expresionRelacional 
                   | expresionAritmetica 
                   | llamadaFuncion
                   | literal

//literales
literal ::= digitos | letras | identificador

//llamadas
llamadaFuncion ::= identificador abreregalo argumentos cierraregalo
argumentos ::= expresion | expresion "," argumentos

//relacionales
expresionRelacional ::= expresion operadorRelacional expresion
operadorRelacional  ::= snowball | evergreen | minstix | upatree | mary | openslae

//aritmeticas
expresionAritmetica ::= expresion operadorAritmetico expresion
operadorAritmetico  ::= navidad | intercambio | reyes | nochebuena | magos | adviento

//definicion de estrucutras de control
controlFlujo ::= elfo | envuelve | duende | varios | hada
elfo ::= elfo abreregalo expresionRelacional cierraregalo bloque (hada bloque)?
envuelve ::= envuelve abreregalo expresionRelacional cierraregalo bloque
duende ::= duende abreregalo inicializacion ";" expresionRelacional ";" incremento cierraregalo bloque
incremento  ::= identificador quien | identificador grinch
inicializacion  ::= creacionVariable | creacionAsignacion
varios::= varios abreregalo identificador cierraregalo abrecuento casos cierracuento
casos  ::= caso | casos caso
caso   ::= historia literal sigue bloque | último sigue bloque

//retronos
envia ::= envia expresion finregalo
narra ::= narra expresion finregalo
escuchapáá ::= escucha identificador finregalo

//tipos y tokens
tipos ::= rodolfo | bromista | trueno | cupido | cometa
identificador = letra (letra | digito | "_")*
digito = [0-9]
letra = [a-zA-Z]
abreregalo = "("
cierraregalo = ")"
abrecuento = "{"
cierracuento = "}"
entrega = "="
finregalo = ";"    
