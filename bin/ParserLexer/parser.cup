/* Simple +/-/* expression language; parser evaluates constant expressions on the fly*/
package ParserLexer;
import java_cup.runtime.*;
import java.util.ArrayList;
import java.util.HashMap;
import java.io.FileWriter;
import java.io.IOException;


action code {:
    HashMap<String, ArrayList<String>> listaTablasSimbolos = new HashMap<String, ArrayList<String>>();
    String currentHash;

    public void imprimirTablaSimbolos(){
        for (String key : listaTablasSimbolos.keySet()) {
            System.out.println("Tabla de simbolos: " + key);
            System.out.println("Valores: ");
            for (String item : listaTablasSimbolos.get(key)) {
                System.out.println(item);
            }
            System.out.println("");
        }
    }

    //escribir en archivo la tabla de simbolos
    public void escribirTablaSimbolos(String nombreArchivo){
        try {
            FileWriter myWriter = new FileWriter(nombreArchivo);
            for (String key : listaTablasSimbolos.keySet()) {
                myWriter.write("Tabla de simbolos: " + key + "\n");
                myWriter.write("Valores: \n");
                for (String item : listaTablasSimbolos.get(key)) {
                    myWriter.write(item + "\n");
                }
                myWriter.write("\n");
            }
            myWriter.close();
            System.out.println("Tabla de simbolos guardada en " + nombreArchivo);
        } catch (IOException e) {
            System.out.println("An error occurred.");
            e.printStackTrace();
        }
    }
:}

parser code {:
    Lexer lex;

    @SuppressWarnings("deprecation")
    public parser(Lexer lex){
        this.lex = lex;
        this.symbolFactory = new DefaultSymbolFactory();
    }
:}

/* define how to connect to the scanner! */
init with {: :};
scan with {: return lex.next_token(); :};

//Terminales de tipos
terminal INTEGER, FLOAT, BOOL, CHAR, STRING;

//Terminales relacionales
terminal MENOR, MENORIGUAL, MAYOR, MAYORIGUAL, IGUALDAD, DIFERENTE;

//Terminales de parentesis y llaves
terminal PARENIZQ, PARENDER, BRACEIZQ, BRACEDER, CORCHETEIZQ, CORCHETEDER;

//Terminales aritmeticos unarios 
terminal INCREMENTO, DECREMENTO;

//Terminales aritmeticos binarios
terminal SUMA, RESTA, DIVISION, MULTIPLICACION, MODULO, POTENCIA;

//Terminales operadores logicos
terminal CONJUNCION, DISYUNCION, NEGACION;

//Terminales estructuras de control de flujo
terminal IF, ELSE, FOR, WHILE, SWITCH, CASE, BREAK, RETURN, DOSPUNTOS;

//Terminales de identificadores y main
terminal IDENTIFICADOR, NUMERO, ERROR, ASIGNACION, MAIN;

//Terminales de finalizacion
terminal ENDEXPR, COMMA, COMILLA, COMILLADOBLE;

//terminales IO
terminal PRINT, READ;

//terminales booleanos
terminal TRUE, FALSE;

//terminales comentarios
terminal COMENTARIO, MULTICOMENTARIO;

//terminal de default
terminal DEFAULT;

//no terminales 
non terminal funcion, inicio, _verano_;
non terminal funciones;
non terminal funciones_produ, parametros, bloque_funcion, funcionRecur;
non terminal funcion_produ, tipos, cupido, cometa, bromista, trueno;
non terminal bloque_produ, sentencias, sentencia_fin, sentencia;
non terminal if_produ, hada, for_produ, while_produ, switch_produ, historia_produ, casos, sentenciaRelacional, sentenciaArit, sentenciaAritUnaria, creacionVariableNum;
non terminal historia, CASO, ultimo, asignaRegalo;
non terminal parametrosRecur, creacionVariable, controlFlujo, expresion, envia, narra, escucha;
non terminal literal, sigue;  
non terminal narra_produ, flujos;
non terminal condicion;

start with _verano_;


_verano_ ::= 
    funcion
    {: 
        imprimirTablaSimbolos();
        escribirTablaSimbolos("tablaSimbolos.txt");
        System.out.println("---Fin---");
    :};

funcion ::= {:System.out.println("\nInicio");:} funcionRecur;

//llamada recursiva para llamar varias funciones
funcionRecur ::= funcion_produ | funcionRecur funcion_produ ;
//aqui se definen los distintos tipos de funciones
//funciona como el encabezado
funcion_produ ::= funciones_produ bloque_produ;

funciones_produ ::= 
    //nota: pusimos INTEGER simulando el int main(){} de c++
    INTEGER MAIN PARENIZQ PARENDER
    {://Funcion main
        String tipo_dato = "tipo: int";
        ArrayList<String> listaDatos = new ArrayList<String>();
        currentHash = "main";
        String nombre_func = "nombre: _verano_";
        String ambito = "ambito: Funcion\n";
        listaDatos.add(tipo_dato);
        listaDatos.add(nombre_func);
        listaDatos.add(ambito);
        listaTablasSimbolos.put(currentHash, listaDatos);
    :}
    //cualquier funcion sin parametros
    | tipos:t IDENTIFICADOR:iden PARENIZQ PARENDER
    {://Funcion sin parametros
    //tipo
        String tipo_dato = "tipo: " + t.toString() + "\n";

        ArrayList<String> listaDatos = new ArrayList<String>();
        currentHash = "funcion";
        String nombre_func = "nombre: " + "\n";
        String ambito = "ambito: Funcion\n";
        listaDatos.add(tipo_dato);
        listaDatos.add(nombre_func);
        listaDatos.add(ambito);
        listaTablasSimbolos.put(currentHash, listaDatos);
    :}
    | tipos IDENTIFICADOR PARENIZQ
    {://tipo
        String tipo_dato = "tipo: "; //+ $1.value.toString() + "\n";

        ArrayList<String> listaDatos = new ArrayList<String>();
        currentHash = "funcion";
        String nombre_func = "nombre: "  + "\n";
        String ambito = "ambito: Funcion\n";
        listaDatos.add(tipo_dato);
        listaDatos.add(nombre_func);
        listaDatos.add(ambito);
        listaTablasSimbolos.put(currentHash, listaDatos);
    :} parametros PARENDER
    ;
    

tipos ::= 
    INTEGER {:RESULT = "int";:}
    | FLOAT {:RESULT = "float";:}
    | BOOL {:RESULT = "bool";:}
    | CHAR {:RESULT = "char";:}
    | STRING {:RESULT = "string";:};

//cuerpo de las funciones

bloque_produ ::= 
    BRACEIZQ sentencias BRACEDER
    ;

sentencias ::= sentencia ENDEXPR | sentencias sentencia ENDEXPR | sentencias if_produ | sentencias for_produ | sentencias while_produ | sentencias switch_produ;

sentencia ::= creacionVariable  
                | narra_produ 
                | escucha 
                | envia;

//defincion de las ops de sentencia
//creaacion variable
creacionVariable ::= tipos IDENTIFICADOR ASIGNACION NUMERO | 
                    tipos IDENTIFICADOR ASIGNACION CHAR |
                    tipos IDENTIFICADOR ASIGNACION STRING |
                    tipos IDENTIFICADOR ASIGNACION FLOAT |
                    tipos IDENTIFICADOR ASIGNACION BOOL;

//narra
narra_produ ::= PRINT STRING;

//escucha
escucha ::= READ STRING;

//envia
envia ::= RETURN STRING | RETURN NUMERO | RETURN FLOAT | RETURN CHAR | RETURN BOOL;

//producciones de estructuras de control
//if y else
if_produ ::= 
    IF PARENIZQ condicion PARENDER bloque_produ
    | IF PARENIZQ condicion PARENDER bloque_produ hada bloque_produ
    ;

//for
for_produ ::= 
    FOR PARENIZQ creacionVariable COMMA condicion COMMA sentenciaArit PARENDER bloque_produ 
    | FOR PARENIZQ creacionVariable COMMA condicion COMMA sentenciaAritUnaria PARENDER bloque_produ
    ;

//while
while_produ ::= 
    WHILE PARENIZQ condicion PARENDER bloque_produ
    ;

//switch

switch_produ ::= SWITCH PARENIZQ IDENTIFICADOR PARENDER BRACEIZQ historia_produ BRACEDER 
    ;

historia_produ ::= casos | historia_produ casos;
casos ::= CASE STRING DOSPUNTOS sentencias BREAK ENDEXPR | DEFAULT DOSPUNTOS sentencias BREAK ENDEXPR
    ;

//sentencia relacional
sentenciaRelacional ::= 
    | IDENTIFICADOR MENOR NUMERO
    | IDENTIFICADOR MENOR IDENTIFICADOR
    | IDENTIFICADOR MENORIGUAL NUMERO
    | IDENTIFICADOR MENORIGUAL IDENTIFICADOR
    | IDENTIFICADOR MAYOR NUMERO
    | IDENTIFICADOR MAYOR IDENTIFICADOR
    | IDENTIFICADOR MAYORIGUAL NUMERO
    | IDENTIFICADOR MAYORIGUAL IDENTIFICADOR
    | IDENTIFICADOR IGUALDAD NUMERO
    | IDENTIFICADOR IGUALDAD IDENTIFICADOR
    | IDENTIFICADOR DIFERENTE NUMERO
    | IDENTIFICADOR DIFERENTE IDENTIFICADOR
    | IDENTIFICADOR DIFERENTE STRING
    | IDENTIFICADOR IGUALDAD STRING
    | IDENTIFICADOR DIFERENTE CHAR
    | IDENTIFICADOR IGUALDAD CHAR
    | IDENTIFICADOR DIFERENTE FLOAT
    | IDENTIFICADOR IGUALDAD FLOAT
    | IDENTIFICADOR DIFERENTE BOOL
    | IDENTIFICADOR IGUALDAD BOOL
    | NUMERO IGUALDAD NUMERO
    ;
//sentencia de condiciones
condicion ::= TRUE | FALSE
            | sentenciaRelacional;
//arreglo
//asignaRegalo ::= PERSONA ABREEMPAQUE exprRegalo CIERRAEMPAQUE ENTREGA exprRegalo | PERSONA ENTREGA exprRegalo ;

//sentencia aritmetica
sentenciaArit ::= 
    IDENTIFICADOR ASIGNACION NUMERO
    | IDENTIFICADOR ASIGNACION IDENTIFICADOR SUMA NUMERO
    | IDENTIFICADOR ASIGNACION IDENTIFICADOR RESTA NUMERO
    | IDENTIFICADOR ASIGNACION IDENTIFICADOR MULTIPLICACION NUMERO
    | IDENTIFICADOR ASIGNACION IDENTIFICADOR DIVISION NUMERO
    | IDENTIFICADOR ASIGNACION IDENTIFICADOR MODULO NUMERO
    | IDENTIFICADOR ASIGNACION IDENTIFICADOR POTENCIA NUMERO;

//sentencia aritmetica unaria
sentenciaAritUnaria ::= 
    IDENTIFICADOR INCREMENTO
    | IDENTIFICADOR DECREMENTO;

//parametros definidos recursivamente por si viene mas de uno
parametros ::= parametrosRecur | parametros COMMA parametrosRecur ;
parametrosRecur  ::= tipos IDENTIFICADOR 
{://tipo
        String tipo_dat = "tipo: parametro"; //+ $1.value.toString() + "\n";

        ArrayList<String> listaDatos = new ArrayList<String>();
        currentHash = "funcion";
        String nombre = "nombre: "  + "\n";
        String ambito_param = "ambito: variable local\n";
        listaDatos.add(tipo_dat);
        listaDatos.add(nombre);
        listaDatos.add(ambito_param);
        listaTablasSimbolos.put(currentHash, listaDatos);
:};