/* Simple +/-/* expression language; parser evaluates constant expressions on the fly*/
package ParserLexer;
import java_cup.runtime.*;
import java.util.ArrayList;
import java.util.HashMap;
import java.io.FileWriter;
import java.io.IOException;


action code {:
    HashMap<String, ArrayList<String>> listaTablasSimbolos = new HashMap<String, ArrayList<String>>();
    String currentHash;

    public void imprimirTablaSimbolos(){
        for (String key : listaTablasSimbolos.keySet()) {
            System.out.println("Tabla de simbolos: " + key);
            System.out.println("Valores: ");
            for (String item : listaTablasSimbolos.get(key)) {
                System.out.println(item);
            }
            System.out.println("");
        }
    }

    //escribir en archivo la tabla de simbolos
    public void escribirTablaSimbolos(String nombreArchivo){
        try {
            FileWriter myWriter = new FileWriter(nombreArchivo);
            for (String key : listaTablasSimbolos.keySet()) {
                myWriter.write("Tabla de simbolos: " + key + "\n");
                myWriter.write("Valores: \n");
                for (String item : listaTablasSimbolos.get(key)) {
                    myWriter.write(item + ", ");
                }
                myWriter.write("\n");
            }
            myWriter.close();
            System.out.println("Tabla de simbolos guardada en " + nombreArchivo);
        } catch (IOException e) {
            System.out.println("An error occurred.");
            e.printStackTrace();
        }
    }
:}

parser code {:
    Lexer lex;

    boolean syntaxErrorPrograma = false;
    @SuppressWarnings("deprecation")
    public parser(Lexer lex){
        this.lex = lex;
        this.symbolFactory = new DefaultSymbolFactory();
    }
:}

/* define how to connect to the scanner! */
init with {: :};
scan with {: return lex.next_token(); :};

//Terminales de tipos
terminal INTEGER, FLOAT, BOOL, CHAR, STRING, VOID;

//Terminales relacionales
terminal MENOR, MENORIGUAL, MAYOR, MAYORIGUAL, IGUALDAD, DIFERENTE;

//Terminales de parentesis y llaves
terminal PARENIZQ, PARENDER, BRACEIZQ, BRACEDER, CORCHETEIZQ, CORCHETEDER;

//Terminales aritmeticos unarios 
terminal INCREMENTO, DECREMENTO;

//Terminales aritmeticos binarios
terminal SUMA, RESTA, DIVISION, MULTIPLICACION, MODULO, POTENCIA;

//Terminales operadores logicos
terminal CONJUNCION, DISYUNCION, NEGACION;

//Terminales estructuras de control de flujo
terminal IF, ELSE, FOR, WHILE, SWITCH, CASE, BREAK, RETURN, DOSPUNTOS;

//Terminales de identificadores y main
terminal IDENTIFICADOR, NUMERO, ERROR, ASIGNACION, MAIN;

//Terminales de finalizacion
terminal ENDEXPR, COMMA, COMILLA, COMILLADOBLE;

//terminales IO
terminal PRINT, READ;

//terminales booleanos
terminal TRUE, FALSE;

//terminales comentarios
terminal COMENTARIO, MULTICOMENTARIO;

//terminal de default
terminal DEFAULT;

//no terminales 
//funciones
non terminal funcion, _verano_, funciones_produ, parametros, funcionRecur, funcion_produ, parametrosOpcionales;

//sentencias
non terminal tipos;
non terminal bloque_produ, sentencias, sentencia;

//flujos
non terminal if_produ, for_produ, while_produ, switch_produ, historia_produ, casodefault, estructurasControl;  
non terminal return_produ, break_produ, print_produ, read_produ, llamadaFuncion;


non terminal exprArit, exprLog, exprRel, factor, exprPrin ;
non terminal operadorLog, operadorRel, operadorArit, operandoUnario;
non terminal accesoArreglo, creacion, asignacion, creacionasignacion, creacionArreglo, modificacionArreglo, valoresArreglo;

start with _verano_;


_verano_ ::= 
    funcion
    {: 
        imprimirTablaSimbolos();
        escribirTablaSimbolos("tablaSimbolos.txt");
        System.out.println("---Fin---");
    :};

funcion ::= {:System.out.println("\nInicio");:} funcionRecur;

//llamada recursiva para llamar varias funciones
funcionRecur ::= funcion_produ | funcionRecur funcion_produ ;
//aqui se definen los distintos tipos de funciones
//funciona como el encabezado
funcion_produ ::= funciones_produ bloque_produ ;

funciones_produ ::= 
//int _verano_ ()
    tipos:t MAIN PARENIZQ PARENDER
    {://Funcion main
        ArrayList<String> listaDatos = new ArrayList<String>();
        currentHash = "main";
        String nombre_func = "\nnombre: _verano_";
        String tipo_dato = "tipo: " + t.toString();
        String ambito = "ambito: Funcion Main\n";
        listaDatos.add(nombre_func);
        listaDatos.add(tipo_dato);
        listaDatos.add(ambito);
        listaTablasSimbolos.put(currentHash, listaDatos);
    :}
    //cualquier funcion sin parametros
    | tipos:t IDENTIFICADOR:idd PARENIZQ PARENDER
    {://Funcion sin parametros
        ArrayList<String> listaDatos = new ArrayList<String>();
        currentHash = "funcion " + idd.toString();
        String nombre_func = "\nnombre: " + idd.toString();
        String tipo_dato = "tipo: " + t.toString();
        String ambito = "ambito: Funcion\n";
        listaDatos.add(nombre_func);
        listaDatos.add(tipo_dato);
        listaDatos.add(ambito);
        listaTablasSimbolos.put(currentHash, listaDatos);
    :}
    | tipos:t IDENTIFICADOR:idd PARENIZQ
    {://tipo
        ArrayList<String> listaDatos = new ArrayList<String>();
        currentHash = "funcion " + idd.toString();
        String nombre_func = "\nnombre: " + idd.toString();
        String tipo_dato = "tipo: " + t.toString();
        String ambito = "ambito: Funcion\n";
        listaDatos.add(nombre_func);
        listaDatos.add(tipo_dato);
        listaDatos.add(ambito);
        listaTablasSimbolos.put(currentHash, listaDatos);
    :} parametros PARENDER
    | error {:System.out.println("Error: encabezado no coincide con la gramatica. Buscando el '}' final para salir de esta funcion");
        Symbol token;
        do {
            token = lex.next_token(); //este metodo ya lo trae el lexer
            if (token.sym == sym.BRACEDER || token.sym == sym.EOF) { //busca el } final
                System.out.println("Encontrado el } final");
                break; 
            }
        } while (token != null);
    :}
    funcionRecur;
    

tipos ::= 
    INTEGER {:RESULT = "int";:}
    | FLOAT {:RESULT = "float";:}
    | BOOL {:RESULT = "bool";:}
    | CHAR {:RESULT = "char";:}
    | STRING {:RESULT = "string";:}
    | VOID {:RESULT = "void";:};

//cuerpo de las funciones

bloque_produ ::= 
    BRACEIZQ sentencias BRACEDER
    ;

sentencias ::= sentencia | sentencias sentencia |
                error 
                {:
                    System.out.println("Error: falta el token de fin de sentencia (;). Recuperando...");

                    Symbol token;
                    do {
                        token = lex.next_token(); //este metodo ya lo trae el lexer
                        if (token.sym == sym.ENDEXPR || token.sym == sym.EOF) {
                            break; 
                        }
                    } while (token != null); 

                :};



sentencia ::= creacion | asignacion | creacionasignacion | estructurasControl | return_produ | break_produ | print_produ | read_produ | llamadaFuncion | modificacionArreglo | creacionArreglo;
creacionasignacion ::= tipos IDENTIFICADOR ASIGNACION exprPrin ENDEXPR ;
asignacion ::= IDENTIFICADOR ASIGNACION exprPrin ENDEXPR ;
creacion ::= tipos IDENTIFICADOR ENDEXPR ;
 
exprPrin ::= exprLog ;
exprLog ::= exprLog operadorLog exprRel | exprRel | NEGACION exprRel ;
operadorLog ::= DISYUNCION | CONJUNCION ;
 
exprRel ::= exprArit operadorRel exprArit | exprArit ;
operadorRel ::= MAYOR | MENOR | MENORIGUAL | MAYORIGUAL | IGUALDAD | DIFERENTE; //XXX TERMINAR
 
exprArit ::= exprArit operadorArit factor
	| factor ;
 
operandoUnario ::= IDENTIFICADOR INCREMENTO
		| IDENTIFICADOR DECREMENTO ;
 
accesoArreglo ::= IDENTIFICADOR CORCHETEIZQ exprPrin CORCHETEDER ;
 
factor ::= NUMERO
    | CHAR
    | STRING
    | BOOL
    | llamadaFuncion
	| operandoUnario
	| accesoArreglo
	| IDENTIFICADOR /* XXX faltan factores: literal char, literal string, litaral bool, funcion, acceso arreglo*/
	| PARENIZQ exprPrin PARENDER  ;
 
operadorArit ::=  SUMA | RESTA | DIVISION | MULTIPLICACION | MODULO | POTENCIA ; 

//produccion de return
return_produ ::= RETURN exprPrin ENDEXPR ;

//produccion de break
break_produ ::= BREAK ENDEXPR ;

//produccion de print
print_produ ::= PRINT PARENIZQ exprPrin PARENDER ENDEXPR ;

//produccion de read
read_produ ::= READ PARENIZQ IDENTIFICADOR PARENDER ENDEXPR ;

//estructuras de control de flujo
estructurasControl ::= if_produ | for_produ | while_produ | switch_produ ;
//if y else
if_produ ::= 
    IF PARENIZQ exprPrin PARENDER bloque_produ
    | IF PARENIZQ exprPrin PARENDER bloque_produ ELSE bloque_produ
    ;

//for
for_produ ::= 
    FOR PARENIZQ asignacion ENDEXPR exprPrin ENDEXPR exprPrin PARENDER bloque_produ 
    | FOR PARENIZQ creacionasignacion ENDEXPR exprPrin ENDEXPR exprPrin PARENDER bloque_produ 
    ;

//while
while_produ ::= 
    WHILE PARENIZQ exprPrin PARENDER bloque_produ
    ;

//switch

switch_produ ::= SWITCH PARENIZQ exprPrin PARENDER BRACEIZQ historia_produ casodefault BRACEDER ;

historia_produ ::= CASE factor DOSPUNTOS bloque_produ | historia_produ CASE tipos DOSPUNTOS bloque_produ ;
casodefault ::= DEFAULT DOSPUNTOS bloque_produ | /* vacío */ ;

//llamada de funciones
llamadaFuncion ::= IDENTIFICADOR PARENIZQ parametrosOpcionales PARENDER ENDEXPR ;
parametrosOpcionales ::= parametros | /* vacío */ ;
parametros ::= exprPrin | parametros COMMA exprPrin ;

creacionArreglo ::= tipos IDENTIFICADOR CORCHETEIZQ NUMERO CORCHETEDER ENDEXPR 
                  | tipos IDENTIFICADOR CORCHETEIZQ NUMERO CORCHETEDER ASIGNACION CORCHETEIZQ valoresArreglo CORCHETEDER ENDEXPR ;
valoresArreglo ::= exprPrin | valoresArreglo COMMA exprPrin ;

modificacionArreglo ::= IDENTIFICADOR CORCHETEIZQ exprPrin CORCHETEDER ASIGNACION exprPrin ENDEXPR ;

