/* Simple +/-/* expression language; parser evaluates constant expressions on the fly*/
package ParserLexer;
import java_cup.runtime.*;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.LinkedHashMap;
import java.io.IOException;
import java.io.BufferedWriter;
import java.io.FileWriter;
import ParserLexer.arbol.*;
import java.util.List;
import ParserLexer.TipoDato;

action code {:
    LinkedHashMap<String, ArrayList<String>> listaTablasSimbolos = new LinkedHashMap<String, ArrayList<String>>();
    ArrayList<FunctionObject> funcs = new ArrayList<FunctionObject>();
    HashMap<String, TablaSimbolo> pilaSimbolos = new HashMap<String, TablaSimbolo>();
    String currHash = "";

    public void imprimirTablaSimbolos(){
        for (String key : listaTablasSimbolos.keySet()) {
            System.out.println("Tabla de simbolos: " + key);
            System.out.println("Valores: ");
            for (String item : listaTablasSimbolos.get(key)) {
                System.out.println(item);
            }
            System.out.println("");
        }
    }

    //escribir en archivo la tabla de simbolos
    public void escribirTablaSimbolos(String nombreArchivo){
        try (BufferedWriter writer = new BufferedWriter(new FileWriter(nombreArchivo))) { //revisar si el path esta bien
            for (String key : listaTablasSimbolos.keySet()) {
                writer.write("\nTabla de simbolo: " + key + "\n");
                writer.write("Valores : \n");
                for (String item : listaTablasSimbolos.get(key)) {
                    writer.write(item);
                }
                writer.write("\n");
            }
        } catch (IOException e) {
            System.out.println("Error escribiendo tabla de simbolos");
            e.printStackTrace();
        }
    }

    public TipoDato validarTipos(String ope, Dato op1, Dato op2, ArrayList<TipoDato> tipos){
        if (op1.getTipo() != op2.getTipo()) {
            System.out.println("Error: tipos no compatibles en la operacion " + ope);
            return TipoDato.NULO; //o nulo
        } 
        if (!tipos.contains(op1.getTipo())) {
            System.out.println("Error: tipo no valido en la operacion " + ope);
            return TipoDato.NULO;
        }
        return op1.getTipo();
    }

     public String existeValor(String pSim){
      for (Simbolo valor : pilaSimbolos.get(currHash).getTablaSimbolos()) {
        if (valor.getId() == pSim) {
          //return value.getDireccion();
          return " ";
        }
      }
      return null;
    }

    public FunctionObject buscarFunc(String pId){
      for(FunctionObject func : funcs){
        if(func.getIdFuncion().equals(pId)){
            return func;
        }
      }
      return null;
    }

    public TipoDato getTipo(String pId, boolean reportar){
        for (Simbolo dato : pilaSimbolos.get(currHash).getTablaSimbolos()) {
              System.out.println("A: "+dato.getId());
          if (dato.getId().equals(pId.toString())) {
            System.out.println();
            return Dato.tipoFromString(dato.getTipo());
          }
        }
        if (reportar){
          semantic_error("misc", ("Error semantico en la linea " + (lex.getLine() + 1) + " columna " + (lex.getColumn() + 1) + ": " + "Ya que no se ha definido el id: " + pId));
        }
        return TipoDato.NULO;
    }

    public TipoDato getTipoExpr(ExpressionNode expr) {
        if (expr instanceof LiteralNode) {
            Object value = ((LiteralNode) expr).value;
            if (value instanceof Integer) {
                return TipoDato.INT;
            } else if (value instanceof Float) {
                return TipoDato.FLOAT;
            } else if (value instanceof Boolean) {
                return TipoDato.BOOL;
            } else if (value instanceof String) {
                return TipoDato.STRING;
            }
        } else if (expr instanceof VariableNode) {
            //
        }
        return TipoDato.NULO;
    }

    public TipoDato convert_a_TipoDato (String tipo_var) {
        switch (tipo_var) {
            case "int":
                return TipoDato.INT;
            case "float":
                return TipoDato.FLOAT;
            case "bool":
                return TipoDato.BOOL;
            case "char":
                return TipoDato.CHAR;
            case "string":
                return TipoDato.STRING;
            case "void":
                return TipoDato.VOID;
            default:
                return TipoDato.NULO;
        }
    }
:}

parser code {:
       // Connect this parser to a scanner!
    Lexer lex;
    boolean syntaxError;
    ArrayList<String> errores = new ArrayList<String>();
    String errorActual = "";
    @SuppressWarnings("deprecation")
    public parser(Lexer lex){
        this.lex = lex;
        this.symbolFactory = new DefaultSymbolFactory();
        this.syntaxError = false; // Inicializar el booleano de errores
    }


    /*Funcion syntax_error sobreescrita para el manejo de errores en idioma espaniol 
    Recibe de parametro el symbol del token actual en el que se ha encontrado un error
    No retorna nada 
    */
    public void syntax_error(Symbol errorSymbol) {//Se imprime la linea y columna del error
        errorActual = "Error sintactico en la linea: " + errorSymbol.left + ", y columna " + errorSymbol.right;
        //System.err.println("Error sintactico en la linea: " + errorSymbol.left + ", y columna " + errorSymbol.right );
        this.errores.add(errorActual);
        this.syntaxError = true; //El booleano se pone en true para indicar que se encontro un error 
    }

    public void semantic_error(String pTipo, String pExpresion){
        switch(pTipo){
          case "var":
              //System.out.println("Error semantico local en la linea " + (lex.getLine()+1) + " columna " + lex.getColumn() + ": " + "Debido al dato ya existente: " + pExpresion);
              errorActual = "Error semantico en la linea " + (lex.getLine()+1) + " columna " + lex.getColumn() + ": " + "Debido a la variable ya existente: " + pExpresion;
              this.errores.add(errorActual);
              this.syntaxError = true;
              break;
          case "param":
              //System.out.println("Error semantico local en la linea " + (lex.getLine()+1) + " columna " + lex.getColumn() + ": " + "Debido al dato ya existente: " + pExpresion);
              errorActual = "Error semantico en la linea " + (lex.getLine()+1) + " columna " + lex.getColumn() + ": " + "Debido al parametro repetido: " + pExpresion;
              this.errores.add(errorActual);
              this.syntaxError = true;
              break;
          case "fun":
              //System.out.println("Error semantico local en la linea " + (lex.getLine()+1) + " columna " + lex.getColumn() + ": " + "Debido al dato ya existente: " + pExpresion);
              errorActual = "Error semantico en la linea " + (lex.getLine()+1) + " columna " + lex.getColumn() + ": " + "Debido a la funcion ya existente: " + pExpresion;
              this.errores.add(errorActual);
              this.syntaxError = true;
              break;
          case "main":
              errorActual = "Error semantico debido a que no existe funcion main";
              this.errores.add(errorActual);
              this.syntaxError = true;
              break;
          case "ftipo":
              errorActual = "Error semantico en la linea " + (lex.getLine() + 1) + " columna " + (lex.getColumn() + 1) + ": " + "El tipo " + pExpresion + " no es valido para una funcion";
              this.errores.add(errorActual);
              this.syntaxError = true;
              break;
           case "misc":
              this.errores.add(pExpresion);
              this.syntaxError = true;
              break;

//variable no existente: var
//mal retorno: return
//mala asignacion: assign
//
          
        }
    }
    // Metodo que verifica si hubo un error sintactico, el cual no recibe ni retorna valores 
    public boolean huboError() {
        return syntaxError;
    }

    //Metodo que imprime si hubo error sintactico y si la gramatica puede ser generada 
    public void estadoGramatica() {
        if (huboError()) {
            System.out.println("El archivo fuente no puede ser generado por la gramatica, debido a errores encontrados en estas partes del archivo:\n");
            for(String currentError : errores){
                System.out.println("\t " + currentError);            
            }

        } else {
            System.out.println("El archivo fuente si puede ser generado por la gramatica");
        }
    }
:}

/* define how to connect to the scanner! */
init with {: :};
scan with {: return lex.next_token(); :};

//Terminales de tipos
terminal INTEGER, FLOAT, BOOL, CHAR, STRING, VOID, NULO;

//Terminales relacionales
terminal MENOR, MENORIGUAL, MAYOR, MAYORIGUAL, IGUALDAD, DIFERENTE;

//Terminales de parentesis y llaves
terminal PARENIZQ, PARENDER, BRACEIZQ, BRACEDER, CORCHETEIZQ, CORCHETEDER;

//Terminales aritmeticos unarios 
terminal INCREMENTO, DECREMENTO;

//Terminales aritmeticos binarios
terminal SUMA, RESTA, DIVISION, MULTIPLICACION, MODULO, POTENCIA;

//Terminales operadores logicos
terminal CONJUNCION, DISYUNCION, NEGACION;

//Terminales estructuras de control de flujo
terminal IF, ELSE, FOR, WHILE, SWITCH, CASE, BREAK, RETURN, DOSPUNTOS;

//Terminales de identificadores y main
terminal IDENTIFICADOR, NUMERO, ERROR, ASIGNACION, MAIN;

//Terminales de finalizacion
terminal ENDEXPR, COMMA, COMILLA, COMILLADOBLE;

//terminales IO
terminal PRINT, READ;

//terminales booleanos
terminal TRUE, FALSE;

//terminales comentarios
terminal COMENTARIO, MULTICOMENTARIO;

//terminal de default
terminal DEFAULT;

//no terminales 
//funciones
non terminal inicio;
non terminal tipos;

//flujos
non terminal estructurasControl;  



//non terminal exprArit, exprLog, exprRel, factor, exprPrin ;

non terminal operadorLog, operadorRel, operadorArit;

// Declaración de no terminales
non terminal ProgramNode program;
non terminal FunctionNode funcion; //esto es funcion
non terminal List<FunctionNode> funciones; //esto es funcionessss
non terminal BlockNode bloque_produ;
non terminal List<StatementNode> sentencias; //parametro de bloque
non terminal List<CaseNode> historia_produ;
non terminal List<ExpressionNode> parametrosOpcionales;
non terminal List<ExpressionNode> parametros, valoresArreglo;
non terminal StatementNode sentencia, if_produ, for_produ, while_produ, switch_produ, creacion, asignacion, creacionasignacion, return_produ, break_produ, print_produ, read_produ, creacionArreglo, modificacionArreglo;
non terminal ExpressionNode  exprPrin, exprLog, exprRel, exprArit, operandoUnario, factor, casodefault, llamadaFuncion, accesoArreglo;




//poner precedencias

start with inicio;

inicio ::= 
    funciones:f
    {: 
        RESULT = new ProgramNode(f);
        
        imprimirTablaSimbolos();
        escribirTablaSimbolos("tablaSimbolos.txt");
        System.out.println("---Fin---");
    :};

funciones ::= funcion:f {: List<FunctionNode> list = new ArrayList<>(); list.add(f); RESULT = list; :}
            | funciones:f1 funcion:f2 {: f1.add(f2); RESULT = f1; :};


funcion ::= 
            //funcion sin parametros 
            tipos:t IDENTIFICADOR:id PARENIZQ PARENDER
            {: 
                //semantica 
                if (listaTablasSimbolos.containsKey(id.toString())) {
                    semantic_error("fun", id.toString());
                    System.out.println("Funcion " + id.toString() + " ya creada");
                } else {
                //agregar a la tabla de simbolos
                ArrayList<String> listaDatos = new ArrayList<String>();
                currHash = id.toString();
                String nombre_func = " nombre: " + id.toString();
                String tipo_dato = "tipo: " + t.toString() + ", ";
                String datos = "Funcion: ";
                datos = datos + tipo_dato + nombre_func;
                listaDatos.add(datos);
                pilaSimbolos.put(currHash, new TablaSimbolo());
                pilaSimbolos.get(currHash).getTablaSimbolos().add(new Simbolo("funcion", t.toString(), id.toString()));
                listaTablasSimbolos.put(currHash, listaDatos);
                switch (t.toString()) {
                    case "int":
                        funcs.add(new FunctionObject(id.toString(), TipoDato.INT, new TipoDato[] {}, true));
                        break;
                    case "float":
                        funcs.add(new FunctionObject(id.toString(), TipoDato.FLOAT, new TipoDato[] {}, true));
                        break;
                    case "bool":
                        funcs.add(new FunctionObject(id.toString(), TipoDato.BOOL, new TipoDato[] {}, true));
                        break;
                    case "char":
                        funcs.add(new FunctionObject(id.toString(), TipoDato.CHAR, new TipoDato[] {}, true));
                        break;
                    case "string":
                        funcs.add(new FunctionObject(id.toString(), TipoDato.STRING, new TipoDato[] {}, true));
                        break;
                    case "void":
                        funcs.add(new FunctionObject(id.toString(), TipoDato.VOID, new TipoDato[] {}, true));
                        break;
                    default:
                        semantic_error("tipo de funcion ", t.toString());
                        System.out.println("Error semantico en la linea " + (lex.getLine()) + " Debido a que el tipo de funcion no es valido");
                        break;
                }
                }
            :} bloque_produ:b {: RESULT = new FunctionNode(id.toString(), b); :} 

            //funcion con parametros
            | tipos:t IDENTIFICADOR:id PARENIZQ parametros PARENDER 
            {: 
                //semantica
                if (listaTablasSimbolos.containsKey("funcion " + id.toString())) {
                    semantic_error("fun", id.toString());
                    System.out.println("Funcion " + id.toString() + " ya creada");
                } else {
                //agregar a la tabla de simbolos
                ArrayList<String> listaDatos = new ArrayList<String>();
                currHash = id.toString();
                String nombre_func = "nombre: " + id.toString();
                String tipo_dato = "tipo: " + t.toString();
                String datos = "Funcion ,";
                datos = datos + tipo_dato + nombre_func;
                listaDatos.add(datos);
                pilaSimbolos.put(currHash, new TablaSimbolo());
                pilaSimbolos.get(currHash).getTablaSimbolos().add(new Simbolo("funcion", t.toString(), id.toString()));
                listaTablasSimbolos.put(currHash, listaDatos);
                switch (t.toString()) {
                    case "rodolfo":
                        funcs.add(new FunctionObject(id.toString(), TipoDato.INT, new TipoDato[] {}, true));
                        break;
                    case "bromista":
                        funcs.add(new FunctionObject(id.toString(), TipoDato.FLOAT, new TipoDato[] {}, true));
                        break;
                    case "trueno":
                        funcs.add(new FunctionObject(id.toString(), TipoDato.BOOL, new TipoDato[] {}, true));
                        break;
                    case "cupido":
                        funcs.add(new FunctionObject(id.toString(), TipoDato.CHAR, new TipoDato[] {}, true));
                        break;
                    case "cometa":
                        funcs.add(new FunctionObject(id.toString(), TipoDato.STRING, new TipoDato[] {}, true));
                        break;
                    case "void":
                        funcs.add(new FunctionObject(id.toString(), TipoDato.VOID, new TipoDato[] {}, true));
                        break;
                    default:
                        semantic_error("tipo de funcion ", t.toString());
                        break;
                }
                }
            :} bloque_produ:b {: RESULT = new FunctionNode(id.toString(), b); :}

            //error en la declaracion de la funcion
            | error {:System.out.println("Error: encabezado no coincide con la gramatica.");
                Symbol token;
                do {
                    token = lex.next_token(); //este metodo ya lo trae el lexer
                    if (token.sym == sym.BRACEDER || token.sym == sym.EOF) { //busca el } final
                        System.out.println("Encontrado el } final");
                        break; 
                    }
                } while (token != null);
            :};

tipos ::= 
    INTEGER {:RESULT = "int";:}
    | FLOAT {:RESULT = "float";:}
    | BOOL {:RESULT = "bool";:}
    | CHAR {:RESULT = "char";:}
    | STRING {:RESULT = "string";:}
    | VOID {:RESULT = "void";:};

//cuerpo de las funciones

bloque_produ ::= 
    BRACEIZQ sentencias:s BRACEDER {: RESULT = new BlockNode(s); :};

sentencias ::= 
    sentencia:s 
        {: 
            List<StatementNode> list = new ArrayList<>(); 
            if (s == null) {
                System.out.println("ADVERTENCIA: Se intentó agregar una sentencia NULL a `sentencias`");
            } else {
                list.add(s);
            }
            RESULT = list;  
        :}
    | sentencias:s1 sentencia:s2 
        {: 
            if (s1 == null) {
                s1 = new ArrayList<>();
            }
            if (s2 == null) {
                System.out.println("ADVERTENCIA: Se intentó agregar una sentencia NULL a `sentencias`");
            } else {
                s1.add(s2);
            }
            RESULT = s1; 
        :}
    | error 
        {:
            System.out.println("Error: error en sentencia. Recuperando...");

            Symbol token;
                do {
                    token = lex.next_token(); //este metodo ya lo trae el lexer
                    if (token.sym == sym.ENDEXPR || token.sym == sym.EOF) {
                        break; 
                    }
                } while (token != null); 
        :};

sentencia ::= 
      creacion:c {: RESULT = c; :} 
    | asignacion:a {: RESULT = a; :}
    | creacionasignacion:ca {: RESULT = ca; :}
    | estructurasControl:ec {: RESULT = (StatementNode)ec; :} 
    | return_produ:re {: RESULT = (StatementNode)re; :} 
    | break_produ:br {: RESULT = br; :} 
    | print_produ:pr {: RESULT = (StatementNode)pr; :} 
    | read_produ:rd {: RESULT = (StatementNode)rd; :} 
    | modificacionArreglo:ma {: RESULT = ma; :}
    | creacionArreglo:ca {: RESULT = ca; :};

creacion ::= tipos:t IDENTIFICADOR:id ENDEXPR 
    {: 
        //preparar para agregar a la tabla de simbolos
        String tipoDato = " Tipo Dato: " + t.toString() + ", ";
        String nombre = " Nombre: " + id.toString() + ", ";
        String ambito = " Var Local: ";
        ambito = ambito + nombre + tipoDato;
        List<String> entradas = listaTablasSimbolos.get(currHash);

        //semantica
        Boolean elementoExiste = false;
        if (entradas != null) {
            for (String entrada : entradas) {
                if (entrada.contains(id.toString())) {
                    elementoExiste = true;
                    System.out.println("Variable " + id.toString() + " ya existe");
                    break;
                }
            }
        }
        if (elementoExiste) {
            semantic_error("var", id.toString());
        } else {
            pilaSimbolos.get(currHash).getTablaSimbolos().add(new Simbolo("Var local", t.toString(), id.toString()));
            pilaSimbolos.get(currHash).incrementarIndice(4);
            listaTablasSimbolos.get(currHash).add(ambito);
            RESULT = new CreacionNode(t.toString(), id.toString()); 
        }
    :};
asignacion ::= IDENTIFICADOR:id ASIGNACION exprPrin:e ENDEXPR 
    {: 
        //revisar si la variable existe
        if (existeValor(id.toString()) == null) {
            semantic_error("var", id.toString());
            System.out.println("Error semantico en la linea " + (lex.getLine()) + " Debido a que la variable no existe: " + id.toString());
        } else {
            RESULT = new AsignacionNode(id.toString(), (ExpressionNode)e); 
            //semantica
            var typeVar = getTipo(id.toString(), true);
            var typeExpr = getTipoExpr(e);
            if (typeVar != typeExpr) {
                semantic_error("assign", id.toString());
                System.out.println("Error semantico en la linea " + (lex.getLine() -1) + " Debido a que la asignacion es invalida para la variable de tipo: " + typeVar.toString());
            }
        }
    :};
creacionasignacion ::= tipos:t IDENTIFICADOR:id ASIGNACION exprPrin:e ENDEXPR 
    {: 
        //preparar para agregar a la tabla de simbolos
        String tipoDato = " Tipo Dato: " + t.toString() + ", ";
        String nombre = " Nombre: " + id.toString() + ", ";
        String ambito = " Var Local, ";
        ambito = ambito + nombre + tipoDato;
        List<String> entradas = listaTablasSimbolos.get(currHash);
        Boolean elementoExiste = false;
        if (entradas != null) {
            for (String entrada : entradas) {
                if (entrada.contains(nombre)) {
                    elementoExiste = true;
                    System.out.println("Variable " + id.toString() + " ya existe");
                    break;
                }
            }
        }

        if (elementoExiste) {
            semantic_error("var", id.toString());
        } else {
            //semantica una vez ingresamos
            var typeExpr = getTipoExpr(e);
            if (convert_a_TipoDato(t.toString()) != typeExpr) {
                semantic_error("assign", id.toString());
                System.out.println("Error semantico en la linea " + (lex.getLine() ) + " Debido a que la asignacion es invalida para la variable de tipo: " + t.toString());
            }

            pilaSimbolos.get(currHash).getTablaSimbolos().add(new Simbolo("Var local", t.toString(), id.toString()));
            pilaSimbolos.get(currHash).incrementarIndice(4);
            listaTablasSimbolos.get(currHash).add(ambito);
            RESULT = new CreacionAsignacionNode(t.toString(), id.toString(), (ExpressionNode) e); 
        }
    :};

exprPrin ::= exprLog:elog {: RESULT = elog; :};

exprLog ::= 
    exprLog:e1 operadorLog:op exprRel:e2 
        {: 
            RESULT = new ExpresionLogicaNode(op.toString(), e1, e2); 
        :} 
    | exprRel:erel 
        {: RESULT = erel; :} 
    | NEGACION exprRel:e 
        {: RESULT = new NegacionNode(e); :};

operadorLog ::= DISYUNCION:op {: RESULT = "AND"; :} 
            | CONJUNCION:op {: RESULT = "OR"; :};
 
exprRel ::= exprArit:e1 operadorRel:op exprArit:e2 {: RESULT = new ExpresionRelaNode(op.toString(), e1, e2); :}
            | exprArit:eArit {: RESULT = eArit; :};
operadorRel ::= MAYOR:op {: RESULT = ">";:} 
            | MENOR:op {: RESULT = "<"; :} 
            | MENORIGUAL:op {: RESULT = "=<"; :}
            | MAYORIGUAL:op {: RESULT = "=>"; :} 
            | IGUALDAD:op {: RESULT = "=="; :} 
            | DIFERENTE:op {: RESULT = "!="; :}; 
 
exprArit ::= exprArit:earit1 operadorArit:op factor:fact {: 
                RESULT = new ExpresionAritNode(op.toString(), earit1, fact); :}
    | factor:fact {: RESULT = fact; :} ; 
 
operandoUnario ::= IDENTIFICADOR:id INCREMENTO {: RESULT = new ExpresionUnariaNode(id.toString(), "++"); :}
                | IDENTIFICADOR:id DECREMENTO {: RESULT = new ExpresionUnariaNode(id.toString(), "--"); :};
 
accesoArreglo ::= IDENTIFICADOR:id CORCHETEIZQ exprPrin:e CORCHETEDER {: RESULT = new AccesoArregloNode(id.toString(), e); :};
 
factor ::= INTEGER:inte {: RESULT = new LiteralNode(Integer.parseInt(inte.toString())); :}
    | CHAR:ch {: RESULT = new LiteralNode(ch.toString()); :}
    | STRING:st {: RESULT = new LiteralNode(st.toString()); :}
    | TRUE:tr {: RESULT = new LiteralNode(Boolean.parseBoolean(tr.toString())); :}
    | FALSE:fa {: RESULT = new LiteralNode(Boolean.parseBoolean(fa.toString())); :}
    | FLOAT:fl {: RESULT = new LiteralNode(Float.parseFloat(fl.toString())); :}
    | llamadaFuncion:lf {: RESULT = lf; :} 
	| operandoUnario:opuni {: RESULT = opuni; :}
	| accesoArreglo:acc {: RESULT = acc; :}
	| IDENTIFICADOR:id {: RESULT = new VariableNode(id.toString()); :} 
    //| tipos IDENTIFICADOR
	| PARENIZQ exprPrin:e PARENDER {: RESULT = e; :};
 
operadorArit ::=  SUMA:op {: RESULT = "+" ;:} 
            | RESTA:op {: RESULT = "-"; :}
            | DIVISION:op {: RESULT = "/"; :}
            | MULTIPLICACION:op {: RESULT = "*"; :} 
            | MODULO:op {: RESULT = "%"; :} 
            | POTENCIA:op {: RESULT = "^"; :} ; 

//produccion de return
return_produ ::= RETURN exprPrin:e ENDEXPR 
    {: 
        RESULT = new ReturnNode(e);

        var typeFunc = funcs.get(funcs.size()-1).getTipoReturn(); 
        var typeExpr = getTipoExpr(e);

        if (typeExpr != typeFunc) {semantic_error("misc", "return"); System.out.println("Error semantico en la linea " + (lex.getLine()) + " columna " + (lex.getColumn()) + ": " + "Debido a que el retorno es invalido para la funcion de tipo: " + typeFunc.toString() );}
       // else {funcs.get(funcs.size()-1).setTHayRetorno(true);}
    :} ;

//produccion de break
break_produ ::= BREAK ENDEXPR {: RESULT = new BreakNode(); :} ;

//produccion de print
print_produ ::= PRINT PARENIZQ exprPrin:e PARENDER ENDEXPR {: RESULT = new PrintNode(e); :} ;

//produccion de read
read_produ ::= READ PARENIZQ IDENTIFICADOR:id PARENDER ENDEXPR {: RESULT = new ReadNode(id.toString()); :} ;

//estructuras de control de flujo
estructurasControl ::= if_produ:ifnod {: RESULT = ifnod;:}
                    | for_produ:fornod {:RESULT = fornod; :}
                    | while_produ:whilenod {: RESULT = whilenod; :} 
                    | switch_produ:switchnod {: RESULT = switchnod; :}; 
//if y else
if_produ ::= 
    IF PARENIZQ exprPrin:e PARENDER bloque_produ:b 
    {: 
        System.out.println((e).toString());
        /*
        //comparar tipos
        if (e instanceof ExpresionRelaNode) {
            var operando1 = ((ExpresionRelaNode)e).op1;
            var operando2 = ((ExpresionRelaNode)e).op2;
            var tipos = new ArrayList<TipoDato>(){{
                add(TipoDato.INT);
                add(TipoDato.FLOAT);
                add(TipoDato.BOOL);
                add(TipoDato.CHAR);
                add(TipoDato.STRING);
            }};
            var tipo = validarTipos(((ExpresionRelaNode)e).operador, operando1, operando2, tipos);
            if (tipo == TipoDato.NULO) {
                semantic_error("misc", "Error en la comparacion de tipos");
            }
        }*/
        RESULT = new IfNode(e, b, null); 

    :}
    | IF PARENIZQ exprPrin:e1 PARENDER bloque_produ:b1 ELSE bloque_produ:b2 {: RESULT = new IfNode(e1, b1, b2); :}
    ;

//for
for_produ ::= 
    FOR PARENIZQ asignacion:a exprPrin:e ENDEXPR exprPrin:e1 ENDEXPR PARENDER bloque_produ:b {: RESULT = new ForNode(a, e, e1, b); :} 
    | FOR PARENIZQ creacionasignacion:a1 exprPrin:e2 ENDEXPR exprPrin:e3 ENDEXPR PARENDER bloque_produ:b1 {: RESULT = new ForNode(a1, e2, e3, b1); :} 
    ;

//while
while_produ ::= 
    WHILE PARENIZQ exprPrin:e PARENDER bloque_produ:b3 {: RESULT = new WhileNode(e, b3); :} ;

//switch

switch_produ ::= SWITCH PARENIZQ exprPrin:e PARENDER BRACEIZQ historia_produ:casos casodefault:d BRACEDER {: RESULT = new SwitchNode(e, casos, d); :};

historia_produ ::= CASE factor:f DOSPUNTOS exprPrin:e1 ENDEXPR 
                {: System.out.println("etiqueta:" );
                List<CaseNode> list = new ArrayList<>(); list.add(new CaseNode(f.toString(), (ExpressionNode)e1)); RESULT = list; :}
                | historia_produ:casos2 CASE factor:f DOSPUNTOS exprPrin:e2 ENDEXPR {: casos2.add(new CaseNode(f.toString(), (ExpressionNode)e2)); RESULT = casos2; :};
casodefault ::= DEFAULT DOSPUNTOS exprPrin:e3 ENDEXPR {: RESULT =  e3 ; :} | /* vacío */ {: RESULT = null; :} ;

//llamada de funciones
llamadaFuncion ::= IDENTIFICADOR:id PARENIZQ parametrosOpcionales:params PARENDER 
                    {: RESULT = new LlamadaFuncionNode(id.toString(), params); :};
parametrosOpcionales ::= parametros:param {: RESULT = param; :}| {: RESULT = new ArrayList<ExpressionNode>(); :}/* vacío */ ;
parametros ::= exprPrin:e {: List<ExpressionNode> list = new ArrayList<>(); list.add(e); RESULT = list; :}
            | parametros:p COMMA exprPrin:e1 {: p.add(e1); RESULT = p; :};

creacionArreglo ::= tipos:t IDENTIFICADOR:id CORCHETEIZQ exprPrin:i CORCHETEDER ENDEXPR 
                  {: List<ExpressionNode> list1 = new ArrayList<>(); RESULT = new CreacionArregloNode(t.toString(), id.toString(), i, list1); :}
                  | tipos:t IDENTIFICADOR:id CORCHETEIZQ exprPrin:i CORCHETEDER ASIGNACION CORCHETEIZQ valoresArreglo:vals CORCHETEDER ENDEXPR 
                  {: RESULT = new CreacionArregloNode(t.toString(), id.toString(), i, vals); :};
valoresArreglo ::= exprPrin:e {: List<ExpressionNode> list = new ArrayList<>(); list.add(e); RESULT = list; :}
                 | valoresArreglo:lst COMMA exprPrin:e1 
                 {: lst.add(e1); RESULT = lst; :};

modificacionArreglo ::= IDENTIFICADOR:id CORCHETEIZQ exprPrin:e CORCHETEDER ASIGNACION exprPrin:valor ENDEXPR 
                        {: RESULT = new ModificarArregloNode(id.toString(), e, valor); :};

